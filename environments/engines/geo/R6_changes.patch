+    for i,(x0,y0,rr) in enumerate([(-1.3,-4.6,.65),(1.6,-3.0,.64),(-1.75,.6,.87),(2.25,1.8,.60),(-.95,5.8,.62),(1.5,8,.71),(-2.7,12.3,.59),(.4,3.2,.21),(.1,-2.1,.20)]):
