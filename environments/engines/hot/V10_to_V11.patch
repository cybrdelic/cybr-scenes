+        patch=smooth(-.27,.26,fbm(x*.92+8,y*.81+4,5))
+        warp=.057*fbm(x*5.4,y*4.7,5)+.019*fbm(x*17.1,y*18.7,4)
+        # Staggered accretion margins. Most are low and interrupted, not a rail.
+        rim=.030*np.exp(-((d-.053-warp)/.047)**2)*patch
